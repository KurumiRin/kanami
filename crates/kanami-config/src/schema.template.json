{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kanami config",
  "description": "See docs/config-spec.md for the syntax",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "key": {
      "description": "A single key name",
      "enum": __KEYS__
    },
    "expr": {
      "type": "string",
      "description": "Key expression: \"a\", \"cmd+k\", \"hyper+t\"; \"none\" means disabled. Modifier spellings: __MODIFIERS__"
    },
    "action": {
      "description": "A key expression, or a list of them tapped in turn",
      "oneOf": [
        { "$ref": "#/definitions/expr" },
        { "type": "array", "items": { "$ref": "#/definitions/expr" }, "minItems": 1 }
      ]
    },
    "strategy": {
      "description": "The strategy for deciding tap vs hold; defaults to permissive",
      "enum": ["timeout", "permissive", "eager"]
    },
    "call": { "type": "string", "description": "Calls a global function in [script]" },
    "remaps": {
      "type": "object",
      "description": "Stage-one remap: a physical key -> a single key, a set of modifiers, or none",
      "propertyNames": { "$ref": "#/definitions/key" },
      "additionalProperties": { "$ref": "#/definitions/expr" }
    },
    "rules": {
      "type": "array",
      "description": "Matched in file order; the first rule that hits takes effect",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from"],
        "properties": {
          "from": { "$ref": "#/definitions/expr" },
          "to": { "$ref": "#/definitions/action" },
          "run": { "type": "string", "description": "A shell command run in the background" },
          "tap": { "$ref": "#/definitions/action" },
          "hold": { "$ref": "#/definitions/expr" },
          "strategy": { "$ref": "#/definitions/strategy" },
          "call": { "$ref": "#/definitions/call" },
          "enabled": { "type": "boolean", "description": "When false, this rule has no effect; defaults to true" },
          "when": { "$ref": "#/definitions/when" }
        }
      }
    },
    "groups": {
      "type": "array",
      "description": "Rule groups: the rules in a group share a condition and an on/off switch",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "description": "The group name shown in the UI" },
          "enabled": { "type": "boolean", "description": "When false, the whole group has no effect; defaults to true" },
          "when": { "$ref": "#/definitions/when" },
          "rule": { "$ref": "#/definitions/rules" }
        }
      }
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app": { "type": "array", "items": { "type": "string" }, "description": "The frontmost app's Bundle ID" },
        "app_not": { "type": "array", "items": { "type": "string" } },
        "input_source": { "type": "array", "items": { "type": "string" }, "description": "Input method ID, such as com.apple.keylayout.ABC" },
        "input_source_not": { "type": "array", "items": { "type": "string" } },
        "var": {
          "type": "object",
          "description": "Script variables equal the given values",
          "additionalProperties": { "type": ["string", "boolean", "integer"] }
        },
        "device": { "type": "array", "items": { "type": "string" }, "description": "Keyboard names defined in [device.*]" },
        "device_not": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "properties": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tap_timeout": { "type": "integer", "minimum": 0, "description": "Time limit for deciding tap vs hold (milliseconds); defaults to 200" },
        "combo_timeout": { "type": "integer", "minimum": 0, "description": "Window for deciding simultaneous presses (milliseconds); defaults to 50" },
        "typing_streak": { "type": "integer", "minimum": 0, "description": "Typing streak window (milliseconds): when less than this has passed since the previous key press, tap/hold keys act as taps immediately and combos do not wait. 0 turns it off; defaults to 150" },
        "layer_hud": { "type": "boolean", "description": "About 0.4 seconds after a layer key is held, shows that layer's key layout at the bottom of the screen. Defaults to true" },
        "language": { "enum": ["en", "zh-CN"], "description": "The UI language. When omitted, follows the system language" }
      }
    },
    "remap": { "$ref": "#/definitions/remaps" },
    "rule": { "$ref": "#/definitions/rules" },
    "group": { "$ref": "#/definitions/groups" },
    "layer": {
      "type": "object",
      "description": "Layers, keyed by layer name",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hold": { "$ref": "#/definitions/key" },
          "toggle": { "$ref": "#/definitions/expr" },
          "tap": { "$ref": "#/definitions/action" },
          "strategy": { "$ref": "#/definitions/strategy" },
          "map": {
            "type": "object",
            "propertyNames": { "$ref": "#/definitions/key" },
            "additionalProperties": { "$ref": "#/definitions/action" }
          }
        }
      }
    },
    "combo": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keys"],
        "properties": {
          "keys": { "type": "array", "items": { "$ref": "#/definitions/key" }, "minItems": 2 },
          "to": { "$ref": "#/definitions/action" },
          "run": { "type": "string" },
          "call": { "$ref": "#/definitions/call" },
          "timeout": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "device": {
      "type": "object",
      "description": "Keyboards, keyed by name; run kanami devices to see the IDs",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vendor_id": { "type": "integer" },
          "product_id": { "type": "integer" },
          "product": { "type": "string", "description": "The product name contains this text (case-insensitive)" },
          "inherit": { "type": "boolean", "description": "Whether to also use the rules and remaps that apply to all keyboards; defaults to true" },
          "remap": { "$ref": "#/definitions/remaps" },
          "rule": { "$ref": "#/definitions/rules" },
          "group": { "$ref": "#/definitions/groups" }
        }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "description": "Luau script plugin",
      "properties": {
        "files": { "type": "array", "items": { "type": "string" }, "description": "Script files; relative paths are relative to the directory of the config file" },
        "source": { "type": "string", "description": "Inline script" }
      }
    },
    "test": {
      "type": "array",
      "description": "Rule tests, run with kanami test",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "expect"],
        "properties": {
          "name": { "type": "string" },
          "app": { "type": "string", "description": "The simulated frontmost app" },
          "input_source": { "type": "string", "description": "The simulated input method" },
          "device": { "type": "string", "description": "Which keyboard in [device.*] the simulated keys come from" },
          "input": { "type": "string", "description": "For example \"+caps_lock c -caps_lock\"; \"@300\" means wait" },
          "expect": { "type": "string" }
        }
      }
    }
  }
}
